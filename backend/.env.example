# ─────────────────────────────────────────────────────────────
# QuantLab Backend – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# IndianAPI credentials (https://indianapi.in)
# Both variables are REQUIRED. The server will refuse to start without them.
INDIAN_API_KEY=your_indianapi_key_here
INDIAN_API_BASE_URL=https://stock.indianapi.in

# Optional: override the Uvicorn host/port
# HOST=0.0.0.0
# PORT=8000
